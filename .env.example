# Copy to .env and adjust. run.py loads this file automatically.
# Admin token protecting all Data Center changes (generate a long random value):
EARTHTWIN_ADMIN_TOKEN=change-me-to-a-long-random-string
# Where the SQLite database, uploads, layers and exports are stored (must be persistent in production):
EARTHTWIN_DATA_DIR=./data
# Upload limits in MB
EARTHTWIN_MAX_TABLE_MB=50
EARTHTWIN_MAX_RASTER_MB=2048
# Similarity engine thresholds
EARTHTWIN_MIN_COVERAGE=0.6
EARTHTWIN_MIN_CRITERIA=3
# 1 = seed curated catalogue + demonstration measurements on first start
EARTHTWIN_SEED_DEMO=1
# 1 = allow server-side NASA CMR metadata search
EARTHTWIN_REMOTE_PROVIDERS=1
